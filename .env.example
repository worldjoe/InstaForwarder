INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
# Comma-separated list of Instagram user IDs (numeric) or usernames to watch
INSTAGRAM_TARGET_IDS=12345,another_user
# Target to forward reels to (username without @)
FORWARD_TO=metadisplayuser
# Poll interval seconds
POLL_INTERVAL=60

# Twitter API bearer token (app-only) for `twitter-api-v2`
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# Comma-separated list of Twitter usernames to fetch media from
TWITTER_TARGETS=twitteruser1,twitteruser2

ENABLE_TWITTER=1
ENABLE_IG=1
# Twitter rate limits request types to 15 minutes (900 seconds) for the Free tier
TWITTER_RATE_LIMIT_INTERVAL=960