# DISCLAIMER: Using this bot may violate Instagram's Terms of Service
# and could result in the account specified by `INSTAGRAM_USERNAME`
# being suspended or permanently banned for automated/bot activity.
# For safety, create a separate Instagram account dedicated to this bot
# (do NOT use a personal or primary account). Use at your own risk.

IG_ENABLED_FOR_SENDING=0
WA_ENABLED_FOR_SENDING=1
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
# Comma-separated list of Instagram user IDs (numeric) or usernames to watch
INSTAGRAM_TARGET_IDS=12345,another_user
# Instagram DM recipient (username without @)
INSTAGRAM_FORWARD_TO=instagram_username
# WhatsApp recipient (phone number with country code, e.g., +15551234567)
WHATSAPP_FORWARD_TO=+15551234567
# Poll interval seconds
POLL_INTERVAL=60

# Optional: Chrome for Testing executable path used by WhatsApp (Puppeteer)
CHROME_EXECUTABLE_PATH=

# Twitter API bearer token (app-only) for `twitter-api-v2`
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
# Comma-separated list of Twitter usernames to fetch media from
TWITTER_TARGETS=twitteruser1,twitteruser2

ENABLE_TWITTER=0
ENABLE_IG=0
# Twitter rate limits request types to 15 minutes (900 seconds) for the Free tier
TWITTER_RATE_LIMIT_INTERVAL=9960000
TIKTOK_TARGETS=asmrglow

ENABLE_TIKTOK=1
# Number of recent posts to fetch for username targets
TIKTOK_MAX_DOWNLOADS=3