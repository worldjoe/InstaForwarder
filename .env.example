# ============================================================================
# DISCLAIMER
# ============================================================================
# Using this bot may violate the Terms of Service of all of these services and could result
# in any of these accounts being suspended or permanently
# banned for automated/bot activity. For safety, create a separate Instagram
# account dedicated to this bot (do NOT use a personal or primary account).
# Use at your own risk.

# ============================================================================
# GENERAL SETTINGS
# ============================================================================
# Poll interval in seconds - how often to check for new content. The shorter
# the interval, the (presumably) higher the risk of account suspension/banning.
POLL_INTERVAL=14400

# Log level (error, warn, info, debug, trace) - controls console output verbosity
# error: Only critical errors
# warn: Errors and warnings
# info: Errors, warnings, and informational messages (recommended)
# debug: Detailed debugging information
# trace: Very verbose tracing (includes all ffmpeg/encoding details)
LOG_LEVEL=info

# ============================================================================
# INSTAGRAM SETTINGS
# ============================================================================
# Enable Instagram content fetching (1 = enabled, 0 = disabled)
ENABLE_IG=0

# Enable Instagram as a sending destination (1 = enabled, 0 = disabled)
# Very likely to cause account warnings/suspensions/bans if enabled
# I have since switched to using WhatsApp for sending content
ENABLE_IG_SENDING=0

# Instagram credentials for retrieving and sending content
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password

# Comma-separated list of Instagram user IDs (numeric) or usernames to watch
INSTAGRAM_TARGET_IDS=12345,another_user

# Instagram DM recipient (username without @)
# This should be the username that is tied to your Meta RayBan Display glasses
INSTAGRAM_FORWARD_TO=instagram_username

# Optional: Instagram proxy URL (e.g., http://proxy:port)
# not sure if this even works.
IG_PROXY=

# Optional: Maximum number of reels to fetch per poll
MAX_REELS_PER_POLL=10

# ============================================================================
# WHATSAPP SETTINGS
# ============================================================================
# Enable WhatsApp as a sending destination (1 = enabled, 0 = disabled)
WA_ENABLED_FOR_SENDING=1

# WhatsApp recipient (phone number with country code, e.g., +15551234567)
WHATSAPP_FORWARD_TO=+15551234567

# Optional: Custom Chrome for Testing executable path for WhatsApp (Puppeteer)
# See README for more details on downloading a compatible Chrome version
CHROME_EXECUTABLE_PATH=

# ============================================================================
# TWITTER SETTINGS
# AFAIK none of the TWITTER code works. Twitter's API costs $$ that I don't want to pay.
# ============================================================================
# Enable Twitter content fetching (1 = enabled, 0 = disabled)
ENABLE_TWITTER=0

# Twitter API bearer token (app-only) for twitter-api-v2
TWITTER_BEARER_TOKEN=your_twitter_bearer_token

# Comma-separated list of Twitter usernames to fetch media from
TWITTER_TARGETS=twitteruser1,twitteruser2

# Twitter rate limit interval in milliseconds (Free tier: 15 min = 900000ms)
TWITTER_RATE_LIMIT_INTERVAL=960000

# ============================================================================
# TIKTOK SETTINGS
# ============================================================================
# Enable TikTok content fetching (1 = enabled, 0 = disabled)
ENABLE_TIKTOK=1

# Comma-separated list of TikTok usernames to fetch media from
TIKTOK_TARGETS=asmrglow

# Maximum number of recent posts to fetch per username
TIKTOK_MAX_DOWNLOADS=3

# ============================================================================
# REDGIF SETTINGS
# This is NSFW. Make sure your recipient is of age for receiving NSFW content.
# ============================================================================
# Enable RedGif content fetching (1 = enabled, 0 = disabled)
ENABLE_REDGIF=0

# Comma-separated list of RedGif creator usernames to fetch media from
REDGIF_TARGETS=creator1,creator2

# Maximum number of recent gifs to download per creator
REDGIF_MAX_DOWNLOADS=3

# Sort order for fetching gifs (recent, trending, best)
REDGIF_ORDER=recent